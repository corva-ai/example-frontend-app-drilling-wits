[{"/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/App.js":"1","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/AppSettings.js":"2","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/WITSSummaryChart/index.js":"3","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/WITSSummaryChart/options.js":"4","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/index.js":"5","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/constants.js":"6","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/effects/index.js":"7","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/effects/useWITSSummaryData.js":"8","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/index.js":"9"},{"size":1940,"mtime":1754557343681,"results":"10","hashOfConfig":"11"},{"size":1212,"mtime":1754557343681,"results":"12","hashOfConfig":"11"},{"size":988,"mtime":1754557343682,"results":"13","hashOfConfig":"11"},{"size":871,"mtime":1754557343682,"results":"14","hashOfConfig":"11"},{"size":65,"mtime":1754557343682,"results":"15","hashOfConfig":"11"},{"size":116,"mtime":1754557343682,"results":"16","hashOfConfig":"11"},{"size":69,"mtime":1754557343682,"results":"17","hashOfConfig":"11"},{"size":1846,"mtime":1754557343682,"results":"18","hashOfConfig":"11"},{"size":130,"mtime":1754557343683,"results":"19","hashOfConfig":"11"},{"filePath":"20","messages":"21","errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":2,"fixableWarningCount":0,"source":"22"},"1ha77kv",{"filePath":"23","messages":"24","errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"25"},{"filePath":"26","messages":"27","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"28"},{"filePath":"29","messages":"30","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"31","messages":"32","errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"33"},{"filePath":"34","messages":"35","errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"36"},{"filePath":"37","messages":"38","errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"39"},{"filePath":"40","messages":"41","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"42","messages":"43","errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":2,"fixableWarningCount":0,"source":"44"},"/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/App.js",["45","46"],"/*\n    This example is a simple app which consists of: AppHeader, Select and Highcharts Chart\n*/\nimport { useState } from 'react';\nimport { LoadingIndicator, AppHeader, Select } from '@corva/ui/components';\nimport { MenuItem } from '@material-ui/core';\n\nimport { useWITSSummaryData } from './effects';\nimport { WITSSummaryChart } from './components';\nimport { DATASETS } from './constants';\n\nimport styles from './styles.css';\n\nfunction App(props) {\n  // NOTE: Read asset_id from well. Most datasets are indexed by asset_id.\n  const {\n    well: { asset_id: assetId },\n    coordinates,\n    appHeaderProps,\n  } = props;\n\n  const [dataset, setDataset] = useState(DATASETS[0]);\n  // NOTE: Use custom react hook to encapsulate data fetching/subscriptions logic\n  const { witsSummaryData, loading } = useWITSSummaryData({ assetId, dataset });\n\n  return (\n    <div className={styles.container}>\n      <AppHeader {...appHeaderProps} />\n\n      <div className={styles.content}>\n        <Select\n          value={dataset}\n          onChange={e => setDataset(e.target.value)}\n          FormControlProps={{ className: styles.select }}\n        >\n          {DATASETS.map(dataset => (\n            <MenuItem key={dataset} value={dataset}>\n              {dataset}\n            </MenuItem>\n          ))}\n        </Select>\n\n        {/*Show loading indicator while data is loading*/}\n        {loading && <LoadingIndicator />}\n        {!loading && (\n          <WITSSummaryChart data={witsSummaryData} coordinates={coordinates} dataset={dataset} />\n        )}\n      </div>\n    </div>\n  );\n}\n\n// App.propTypes = {\n//   isExampleCheckboxChecked: PropTypes.bool,\n//   appHeaderProps: PropTypes.shape({}).isRequired,\n// };\n\n// App.defaultProps = {\n//   ...DEFAULT_SETTINGS,\n// };\n\n// Important: Do not change root component default export (App.js). Use it as container\n//  for your App. It's required to make build and zip scripts work as expected;\nexport default App;\n","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/AppSettings.js",["47"],"import { Checkbox, FormControlLabel } from '@material-ui/core';\nimport PropTypes from 'prop-types';\n\nimport { DATASETS } from './constants';\n\nfunction AppSettings({\n  settings: apiSettings,\n  onSettingChange,\n  // appData,\n  // app,\n  // user,\n  // company,\n}) {\n  const settings = { ...DATASETS, ...apiSettings };\n  return (\n    <div>\n      <FormControlLabel\n        label=\"Example checkbox\"\n        control={\n          <Checkbox\n            checked={settings.isExampleCheckboxChecked}\n            onChange={e => onSettingChange('isExampleCheckboxChecked', e.target.checked)}\n          />\n        }\n      />\n    </div>\n  );\n}\n\nAppSettings.propTypes = {\n  app: PropTypes.shape({}).isRequired,\n  appData: PropTypes.shape({}).isRequired,\n  company: PropTypes.shape({}),\n  onSettingChange: PropTypes.func.isRequired,\n  settings: PropTypes.shape({\n    isExampleCheckboxChecked: PropTypes.bool\n  }).isRequired,\n  user: PropTypes.shape({}),\n};\n\nAppSettings.defaultProps = {\n  user: {},\n  company: {},\n};\n\n// Important: Do not change root component default export (AppSettings.js). Use it as container\n//  for your App Settings. It's required to make build and zip scripts work as expected;\nexport default AppSettings;\n","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/WITSSummaryChart/index.js",["48"],"import { useMemo, useRef, useEffect } from 'react';\nimport Highcharts from 'highcharts';\nimport HighchartsReact from 'highcharts-react-official';\n\nimport { getHighchartsOptions } from './options';\nimport styles from './styles.css';\n\nfunction WITSSummaryChart({ data, dataset, coordinates }) {\n  const chartRef = useRef();\n\n  useEffect(() => {\n    // NOTE: Update chart size when container size has changed\n    chartRef.current?.chart.setSize();\n  }, [coordinates]);\n\n  // NOTE: Use memoization technique\n  // Calculate chart options ONLY when data changed.\n  // This will also help avoid choppy animation\n  return useMemo(() => {\n    const options = getHighchartsOptions({ data, dataset });\n\n    return (\n      <HighchartsReact\n        highcharts={Highcharts}\n        options={options}\n        // NOTE: Pass className to style highchart\n        containerProps={{ className: styles.chartContainer }}\n        ref={chartRef}\n      />\n    );\n  }, [data]);\n}\n\nexport default WITSSummaryChart;\n","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/WITSSummaryChart/options.js",[],"/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/components/index.js",["49"],"export { default as WITSSummaryChart } from './WITSSummaryChart';","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/constants.js",["50"],"export const DATASETS = [\n  'wits.summary-6h',\n  'wits.summary-30m',\n  'wits.summary-1m',\n  'wits.summary-1ft',\n\n];\n","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/effects/index.js",["51"],"export { default as useWITSSummaryData } from './useWITSSummaryData';","/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/effects/useWITSSummaryData.js",["52"],"/Users/konstantinzolozhkov/corva/readme_task/example-frontend-app-drilling-wits/src/index.js",["53","54"],"import App from \"./App\";\nimport AppSettings from \"./AppSettings\";\n\nexport default {\n  component: App,\n  settings: AppSettings,\n};\n",{"ruleId":"55","severity":2,"message":"56","line":43,"column":10,"nodeType":"57","messageId":"58","endLine":43,"endColumn":58,"fix":"59"},{"ruleId":"55","severity":2,"message":"60","line":43,"column":10,"nodeType":"57","messageId":"61","endLine":43,"endColumn":58,"fix":"62"},{"ruleId":"63","severity":2,"message":"64","line":36,"column":45,"nodeType":null,"endLine":36,"endColumn":45,"fix":"65"},{"ruleId":"66","severity":1,"message":"67","line":5,"column":1,"nodeType":"68","endLine":5,"endColumn":50,"fix":"69"},{"ruleId":"63","severity":2,"message":"70","line":1,"column":66,"nodeType":null,"endLine":1,"endColumn":66,"fix":"71"},{"ruleId":"63","severity":2,"message":"72","line":6,"column":1,"nodeType":null,"endLine":7,"endColumn":1,"fix":"73"},{"ruleId":"63","severity":2,"message":"70","line":1,"column":70,"nodeType":null,"endLine":1,"endColumn":70,"fix":"74"},{"ruleId":"75","severity":1,"message":"76","line":17,"column":5,"nodeType":"77","messageId":"78","endLine":17,"endColumn":16},{"ruleId":"63","severity":2,"message":"79","line":1,"column":17,"nodeType":null,"endLine":1,"endColumn":24,"fix":"80"},{"ruleId":"63","severity":2,"message":"81","line":2,"column":25,"nodeType":null,"endLine":2,"endColumn":40,"fix":"82"},"spaced-comment","Expected exception block, space or tab after '/*' in comment.","Block","expectedExceptionAfter",{"range":"83","text":"84"},"Expected space or tab before '*/' in comment.","expectedSpaceBefore",{"range":"85","text":"84"},"prettier/prettier","Insert `,`",{"range":"86","text":"87"},"import/order","There should be at least one empty line between import groups","ImportDeclaration",{"range":"88","text":"89"},"Insert `⏎`",{"range":"90","text":"89"},"Delete `⏎`",{"range":"91","text":"92"},{"range":"93","text":"89"},"no-console","Unexpected console statement.","MemberExpression","unexpected","Replace `\"./App\"` with `'./App'`",{"range":"94","text":"95"},"Replace `\"./AppSettings\"` with `'./AppSettings'`",{"range":"96","text":"97"},[1313,1313]," ",[1357,1357],[888,888],",",[196,196],"\n",[65,65],[112,113],"",[69,69],[16,23],"'./App'",[49,64],"'./AppSettings'"]